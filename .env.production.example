# Plantilla de variables de entorno de PRODUCCIÓN para el frontend
# Next.js — ver docs/DEPLOYMENT_IIS.md. Copiá este archivo a ".env"
# (en la raíz del repo, junto a package.json) en el servidor y completá
# los valores reales. Nunca commitees el ".env" real.

# Firma el JWT de sesión de Next.js (cookie "nexo-session") — mínimo 32
# caracteres, generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# URL del backend Django EN ESTE MISMO SERVIDOR (Next.js le habla
# server-side, nunca desde el navegador — ver .claude/rules/architecture.md).
# Con el backend corriendo como servicio en 127.0.0.1:8000 (ver
# backend/scripts/serve_production_windows.py), este valor no cambia
# aunque el dominio público del sitio sí lo haga.
DJANGO_API_URL=http://127.0.0.1:8000/api/v1

# --- Integraciones opcionales: cada feature degrada con gracia si faltan ---
GEMINI_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GITHUB_TOKEN=
GITHUB_DOCS_REPO=owner/nexo-documentos

# NODE_ENV=production lo fija automáticamente "next build"/"next start" —
# no hace falta declararlo acá. Igual: NUNCA lo pises a "development" en
# este archivo, rompe SESSION_COOKIE `secure` (src/lib/session.ts) y el
# CSP endurecido (next.config.ts).
