generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  JEFE_NACIONAL
  COORDINADOR_NACIONAL
  COORDINADOR_ZS
  ANALISTA_CC
  ANALISTA_SELECCION
  ASISTENTE_SELECCION
  ASISTENTE_GH
  ASISTENTE_GH_ZS
  TRABAJO_SOCIAL
  ASISTENTE_NOMINA
}

enum ThemePreference {
  LIGHT
  DARK
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
}

enum TaskPriority {
  ALTA
  MEDIA
  BAJA
}

enum TaskFrequency {
  MENSUAL
  SEMANAL
  DIARIA
  QUINCENAL
  PUNTUAL
}

enum TaskType {
  FIJA
  SEGUIMIENTO
}

enum ActivityReason {
  NOVEDADES_PAGO
  RETENCION_PAGO
  FACTURAS
  CONSULTA_OPERACIONES
  SOLICITUD_VACACIONES
  SOLICITUD_PERMISO
  VISITA_DOMICILIARIA
  SEGUIMIENTO_AUSENTISMOS
  RECLUTAMIENTO_SELECCION
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String
  password        String
  role            Role
  viewPreferences String[]        @default(["KANBAN", "TABLA"])
  theme           ThemePreference @default(LIGHT)
  lastLoginAt     DateTime?
  badges          String[]        @default([])
  dataConsentAccepted   Boolean   @default(false)
  dataConsentAcceptedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  assignedTasks      Task[]              @relation("AssignedTasks")
  createdTasks       Task[]              @relation("CreatedTasks")
  comments           Comment[]
  activities         TaskActivity[]
  notifications      Notification[]
  reports            MonthlyReport[]     @relation("GeneratedReports")
  knowledgeDocs      KnowledgeDocument[]
  announcements      Announcement[]      @relation("AnnouncementAuthor")
  hostedMeetings     Meeting[]           @relation("HostedMeetings")
  meetingInvites     MeetingInvitee[]    @relation("MeetingInvitations")
  closedMonths       MonthClosure[]      @relation("MonthClosures")
  proposedIdeas      ImprovementIdea[]   @relation("IdeaAuthor")
  ideaStatusChanges  IdeaStatusHistory[] @relation("IdeaStatusChanger")
  ideaVotes          IdeaVote[]
  taskCommentViews   TaskCommentView[]
  followUpReminders  FollowUpReminder[]
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  expiresAt DateTime
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Task {
  id             String        @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus    @default(PENDIENTE)
  priority       TaskPriority
  frequency      TaskFrequency
  startDate      DateTime
  endDate        DateTime
  estimatedHours Float
  realHours      Float         @default(0)
  progress       Int           @default(0)
  completedAt    DateTime?
  type           TaskType      @default(FIJA)
  assignedToId   String
  assignedTo     User          @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById    String
  createdBy      User          @relation("CreatedTasks", fields: [createdById], references: [id])
  comments       Comment[]
  activities     TaskActivity[]
  commentViews   TaskCommentView[]
  reminders      FollowUpReminder[]
  color          String?
  archivedMonth  String?
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TaskCommentView {
  id       String   @id @default(cuid())
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  viewedAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  taskId    String?
  taskTitle String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TaskActivity {
  id          String         @id @default(cuid())
  taskId      String
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id])
  reason      ActivityReason
  startTime   String
  endTime     String
  duration    Int
  description String?
  createdAt   DateTime       @default(now())
}

model FollowUpReminder {
  id            String    @id @default(cuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  reminderAt    DateTime
  snoozedUntil  DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, completedAt, reminderAt])
}

enum ReportScope {
  JEFE
  COORDINADOR
}

model MonthlyReport {
  id          String      @id @default(cuid())
  month       Int
  year        Int
  generatedBy String
  generator   User        @relation("GeneratedReports", fields: [generatedBy], references: [id])
  scope       ReportScope
  data        Json
  aiAnalysis  String?
  createdAt   DateTime    @default(now())

  @@unique([month, year, scope])
}

model MonthClosure {
  id             String   @id @default(cuid())
  month          Int
  year           Int
  closedBy       String
  closer         User     @relation("MonthClosures", fields: [closedBy], references: [id])
  closedAt       DateTime @default(now())
  totalTasks     Int
  completedTasks Int
  summary        Json

  @@unique([month, year])
}

enum IdeaImpact {
  ALTO
  MEDIO
  BAJO
}

enum IdeaStatus {
  PROPUESTA
  EN_REVISION
  APROBADA
  EN_DESARROLLO
  EN_PRUEBAS
  IMPLEMENTADA
  RECHAZADA
}

model ImprovementIdea {
  id             String     @id @default(cuid())
  title          String
  description    String
  impact         IdeaImpact
  status         IdeaStatus @default(PROPUESTA)
  progress       Int        @default(0)
  authorId       String
  author         User       @relation("IdeaAuthor", fields: [authorId], references: [id])
  attachmentUrl  String?
  attachmentData String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  history        IdeaStatusHistory[]
  votes          IdeaVote[]
}

model IdeaVote {
  id        String          @id @default(cuid())
  ideaId    String
  idea      ImprovementIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([ideaId, userId])
}

model IdeaStatusHistory {
  id         String          @id @default(cuid())
  ideaId     String
  idea       ImprovementIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  fromStatus IdeaStatus
  toStatus   IdeaStatus
  changedBy  String
  changer    User            @relation("IdeaStatusChanger", fields: [changedBy], references: [id])
  comment    String?
  createdAt  DateTime        @default(now())
}

model KnowledgeDocument {
  id           String          @id @default(cuid())
  title        String
  fileName     String
  uploadedById String
  uploadedBy   User            @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  chunks       DocumentChunk[]
}

model DocumentChunk {
  id          String            @id @default(cuid())
  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content     String
  embedding   Json
  pageNumber  Int
  chunkIndex  Int
}

enum MeetingStatus {
  PROGRAMADA
  EN_CURSO
  FINALIZADA
}

model Meeting {
  id                 String        @id @default(cuid())
  title              String
  description        String?
  hostId             String
  host               User          @relation("HostedMeetings", fields: [hostId], references: [id])
  meetingDate        DateTime
  duration           Int
  zoomMeetingId      String?
  zoomJoinUrl        String?
  zoomPassword       String?
  status             MeetingStatus @default(PROGRAMADA)
  otterInvited       Boolean       @default(false)
  otterSummary       String?
  otterTranscriptUrl String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  invitees           MeetingInvitee[]
}

model MeetingInvitee {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("MeetingInvitations", fields: [userId], references: [id])
  attended  Boolean @default(false)

  @@unique([meetingId, userId])
}
