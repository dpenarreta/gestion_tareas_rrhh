generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  JEFE_NACIONAL
  COORDINADOR_NACIONAL
  COORDINADOR_ZS
  ANALISTA_CC
  ANALISTA_SELECCION
  ASISTENTE_SELECCION
  ASISTENTE_GH
  ASISTENTE_GH_ZS
  TRABAJO_SOCIAL
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
}

enum TaskPriority {
  ALTA
  MEDIA
  BAJA
}

enum TaskFrequency {
  MENSUAL
  SEMANAL
  DIARIA
  QUINCENAL
  PUNTUAL
}

enum TaskType {
  FIJA
  SEGUIMIENTO
}

enum ActivityReason {
  NOVEDADES_PAGO
  RETENCION_PAGO
  FACTURAS
  CONSULTA_OPERACIONES
  SOLICITUD_VACACIONES
  SOLICITUD_PERMISO
  VISITA_DOMICILIARIA
  SEGUIMIENTO_AUSENTISMOS
  RECLUTAMIENTO_SELECCION
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  password        String
  role            Role
  viewPreferences String[] @default(["KANBAN", "TABLA"])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignedTasks      Task[]              @relation("AssignedTasks")
  createdTasks       Task[]              @relation("CreatedTasks")
  comments           Comment[]
  activities         TaskActivity[]
  notifications      Notification[]
  reports            MonthlyReport[]     @relation("GeneratedReports")
  knowledgeDocs      KnowledgeDocument[]
}

model Task {
  id             String        @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus    @default(PENDIENTE)
  priority       TaskPriority
  frequency      TaskFrequency
  startDate      DateTime
  endDate        DateTime
  estimatedHours Float
  realHours      Float         @default(0)
  progress       Int           @default(0)
  type           TaskType      @default(FIJA)
  assignedToId   String
  assignedTo     User          @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById    String
  createdBy      User          @relation("CreatedTasks", fields: [createdById], references: [id])
  comments       Comment[]
  activities     TaskActivity[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  taskId    String?
  taskTitle String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TaskActivity {
  id          String         @id @default(cuid())
  taskId      String
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id])
  reason      ActivityReason
  startTime   String
  endTime     String
  duration    Int
  description String?
  createdAt   DateTime       @default(now())
}

enum ReportScope {
  JEFE
  COORDINADOR
}

model MonthlyReport {
  id          String      @id @default(cuid())
  month       Int
  year        Int
  generatedBy String
  generator   User        @relation("GeneratedReports", fields: [generatedBy], references: [id])
  scope       ReportScope
  data        Json
  aiAnalysis  String?
  createdAt   DateTime    @default(now())

  @@unique([month, year, scope])
}

model KnowledgeDocument {
  id           String          @id @default(cuid())
  title        String
  fileName     String
  uploadedById String
  uploadedBy   User            @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  chunks       DocumentChunk[]
}

model DocumentChunk {
  id          String            @id @default(cuid())
  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content     String
  embedding   Json
  pageNumber  Int
  chunkIndex  Int
}
