generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRADOR
  JEFE_NACIONAL
  COORDINADOR_NACIONAL
  COORDINADOR_ZS
  ANALISTA_CC
  ANALISTA_SELECCION
  ASISTENTE_SELECCION
  ASISTENTE_GH
  ASISTENTE_GH_ZS
  TRABAJO_SOCIAL
  ASISTENTE_NOMINA
}

enum ThemePreference {
  LIGHT
  DARK
}

enum DataRequestType {
  ACCESO
  RECTIFICACION
  ELIMINACION
}

enum DataRequestStatus {
  PENDIENTE
  EN_PROCESO
  RESUELTA
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
}

enum TaskPriority {
  ALTA
  MEDIA
  BAJA
}

enum TaskFrequency {
  MENSUAL
  SEMANAL
  DIARIA
  QUINCENAL
  PUNTUAL
}

enum TaskType {
  FIJA
  SEGUIMIENTO
}

enum LeaveType {
  MEDICO
  PERSONAL
  VACACIONES
}

enum SpecialStatusType {
  MATERNIDAD
  LACTANCIA
}

// Motivo de ajuste al validar el Tiempo Objetivo (§Sprint 6 S6-C).
enum TargetTimeAdjustReason {
  PROCEDIMIENTO_ESTANDAR
  COMPLEJIDAD_DETECTADA
  CAMBIO_ALCANCE
  REVISION_LIDER
  OTRO
}

// Validación de Fecha Fin por líderes — mismo concepto de gobierno que
// TargetTimeAdjustReason/targetTimeValidated, aplicado a Task.endDate en vez
// de a estimatedHours. PENDIENTE es el estado inicial de toda tarea nueva
// (y, retroactivamente, de las existentes al desplegar este campo); los
// otros 3 son terminales hasta que el colaborador vuelve a editar endDate
// (ver resetEndDateToPending en endDateServer.ts), momento en que vuelve a
// PENDIENTE.
enum EndDateApprovalStatus {
  PENDIENTE
  APROBADA
  MODIFICADA
  RECHAZADA
}

// Tipo de evento en EndDateAuditLog — distinto de EndDateApprovalStatus:
// PROPUESTA es un evento (el colaborador propuso/re-propuso un valor), no un
// estado final; los otros 3 son eventos de decisión del líder.
enum EndDateAuditAction {
  PROPUESTA
  APROBADA
  MODIFICADA
  RECHAZADA
}

// ── Módulo Proyectos ─────────────────────────────────────────────────────────
// Dominio independiente del módulo Trabajo (Task/TaskActivity) — ver
// docs/DECISIONS.md. Iniciativas transversales de mediana/larga duración con
// fases, participantes propios y ciclo de vida que NO se cierra por mes.

enum ProjectStatus {
  PENDIENTE
  PLANIFICACION
  EN_EJECUCION
  EN_REVISION
  SUSPENDIDO
  COMPLETADO
  CANCELADO
}

enum ProjectDocumentCategory {
  PDF
  EXCEL
  WORD
  IMAGEN
  CORREO
  ACTA
  OTRO
}

enum ProjectHistoryEvent {
  CREADO
  ACTUALIZADO
  PARTICIPANTE_AGREGADO
  PARTICIPANTE_ELIMINADO
  RESPONSABLE_CAMBIADO
  ESTADO_CAMBIADO
  FASE_AGREGADA
  FASE_ACTUALIZADA
  FASE_ELIMINADA
  COMENTARIO_AGREGADO
  ACTIVIDAD_REGISTRADA
  DOCUMENTO_AGREGADO
  ELIMINADO
  RESTAURADO
}

// ── Centro de Recuperación (arquitectura corporativa, interno) ──────────────
// El usuario solo ve "Papelera" dentro de cada módulo — este nombre y estos
// modelos nunca se exponen en la interfaz. Único mecanismo oficial de
// eliminación temporal/restauración de toda la plataforma (ver
// src/lib/recoveryCenter.ts y docs/AUDIT_LOG.md). `RecoveryItem.entityType`
// es un String (no un enum de Prisma) a propósito: registrar un módulo nuevo
// (Trabajo, Escritorio Digital, Documentos, Repositorios, Plantillas,
// Comunicados) es agregar una entrada al registro en código — cero
// migraciones de schema.

enum RecoveryStatus {
  ACTIVE
  RESTORED
  PURGED
}

enum RecoveryOperation {
  MOVE_TO_TRASH
  RESTORE
  DELETE_PERMANENTLY
  PURGE_EXPIRED
}

enum RecoveryOrigin {
  MANUAL
  AUTOMATIC
}

// ── Escritorio Digital ───────────────────────────────────────────────────────
// Notas rápidas informales entre colaboradores (equivalente digital de un
// Post-it dejado sobre el escritorio físico de alguien) — ver docs/DECISIONS.md.
// Deliberadamente NO es mensajería/correo: sin hilos libres, sin asunto, sin
// destinatarios múltiples — DeskNoteReply permite un intercambio corto (máx.
// 2 respuestas) pero no un chat (§4/§11 del refinamiento 2026-07-23). No
// participa en Analytics/KPIs/carga laboral. El puente hacia Trabajo ya NO es
// directo: una nota se convierte en PersonalReminder (§5), y es el
// recordatorio el que opcionalmente se convierte en Task (§6) — reemplaza al
// puente directo Nota→Tarea del sprint anterior (ver docs/AUDIT_LOG.md).
enum DeskNotePriority {
  INFORMACION
  RECORDATORIO
  IMPORTANTE
  URGENTE
}

// Color del Post-it — independiente de la prioridad (§Sprint evolución §1):
// la prioridad sigue determinando la franja superior; el color es una
// preferencia estética libre de quien escribe la nota, igual que elegir un
// Post-it físico de un color u otro.
enum DeskNoteColor {
  AMARILLO
  ROSADO
  CELESTE
  VERDE
  NARANJA
  LILA
}

model DeskNote {
  id          String           @id @default(cuid())
  senderId    String
  sender      User             @relation("DeskNoteSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User             @relation("DeskNoteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  message     String
  priority    DeskNotePriority @default(INFORMACION)
  color       DeskNoteColor    @default(AMARILLO)
  read        Boolean          @default(false)
  readAt      DateTime?
  pinned      Boolean          @default(false)
  archived    Boolean          @default(false)
  archivedAt  DateTime?
  // Adjunto opcional — mismo patrón que ImprovementIdea.attachmentData /
  // ProjectDocument.fileData (base64 en columna @db.Text, sin integración a
  // almacenamiento externo).
  attachmentName String?
  attachmentMime String?
  attachmentData String?       @db.Text
  // Puente opcional hacia Recordatorios (§5 "Convertir en Recordatorio") — la
  // nota permanece intacta y visible tras convertirse, nunca se elimina ni se
  // modifica su contenido. onDelete: SetNull para que borrar el recordatorio
  // nunca se lleve la nota por delante.
  convertedToReminderId String?
  convertedToReminder   PersonalReminder? @relation("DeskNoteConvertedReminder", fields: [convertedToReminderId], references: [id], onDelete: SetNull)
  convertedAt            DateTime?
  // Bandera local de conveniencia del Centro de Recuperación (adaptador
  // DESK_NOTE en src/lib/recoveryCenter.ts) — usada por el remitente para
  // eliminar una nota que envió (RecoveryItem sigue siendo la fuente de
  // verdad de auditoría/retención de ESA vía). La retención de 15 días del
  // archivo (§7/§8) es un mecanismo aparte, propio del destinatario — ver
  // src/lib/deskNoteRetention.ts — y purga en duro sin pasar por el Centro
  // de Recuperación (no son la misma acción ni el mismo actor).
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())

  replies DeskNoteReply[]

  @@index([recipientId, archived, deletedAt, createdAt])
  @@index([senderId, deletedAt, createdAt])
}

// Intercambio corto sobre una nota (§4) — máximo 2 filas por nota, validado
// en la API (POST /api/desk-notes/[id]/replies), no en el schema. Autor
// puede ser el remitente o el destinatario (los únicos dos participantes).
model DeskNoteReply {
  id        String   @id @default(cuid())
  noteId    String
  note      DeskNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("DeskNoteReplyAuthor", fields: [authorId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@index([noteId, createdAt])
}

// ── Escritorio Digital: Recordatorios personales ────────────────────────────
// Independientes de Task/Project (§7 del sprint de evolución) — reemplazan
// por completo al antiguo FollowUpReminder (ligado a una tarea Fija/
// Seguimiento). Ver docs/AUDIT_LOG.md para la migración de datos.
enum ReminderPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum ReminderStatus {
  PENDIENTE
  COMPLETADO
}

enum ReminderRepeat {
  UNA_VEZ
  DIARIO
  SEMANAL
  MENSUAL
}

// Completado ya NO es un estado definitivo (§Refinamiento ciclo de vida,
// 2026-07-23) — "Reabrir" regresa status a PENDIENTE conservando el mismo
// id, nunca crea una fila nueva. `archived` es una dimensión aparte
// (mismo criterio que DeskNote): un recordatorio completado puede
// archivarse para salir del historial visible sin perder auditoría ni
// eliminarse.
model PersonalReminder {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("PersonalReminderUser", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueAt       DateTime
  priority    ReminderPriority @default(MEDIA)
  status      ReminderStatus   @default(PENDIENTE)
  repeat      ReminderRepeat   @default(UNA_VEZ)
  completedAt DateTime?
  archived    Boolean          @default(false)
  archivedAt  DateTime?
  // Evita notificar el mismo vencimiento más de una vez (barrido perezoso,
  // ver src/lib/deskReminders.ts) — se reinicia a false cada vez que dueAt
  // cambia (edición, posposición, reapertura, o la siguiente ocurrencia de
  // una repetición).
  notified    Boolean          @default(false)
  // Adjunto opcional — se copia (no se referencia) desde la nota de origen al
  // convertir Nota→Recordatorio (§5/§6), para que sobreviva aunque esa nota
  // se archive y se purgue automáticamente a los 15 días (§8). Mismo patrón
  // base64 que DeskNote.attachmentData.
  attachmentName String?
  attachmentMime String?
  attachmentData String?       @db.Text
  // Puente opcional hacia Trabajo (§6 "Crear tarea") — el recordatorio
  // permanece intacto tras convertirse, nunca se elimina. onDelete: SetNull
  // para que borrar la tarea nunca se lleve el recordatorio por delante.
  convertedToTaskId String?
  convertedToTask   Task?      @relation("ReminderConvertedTask", fields: [convertedToTaskId], references: [id], onDelete: SetNull)
  convertedToTaskAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  convertedFromNotes DeskNote[] @relation("DeskNoteConvertedReminder")

  @@index([userId, status, dueAt])
  @@index([userId, archived])
}

// ── Escritorio Digital: Auditoría central ───────────────────────────────────
// Un solo registro para notas Y recordatorios (§14) — mismo criterio que
// RecoveryAuditLog: nunca una tabla de auditoría por tipo de entidad.
// `entityId` es una referencia suelta (sin FK), igual criterio que
// ActivityAuditLog/RecoveryAuditLog, para sobrevivir a la eliminación de la
// entidad original.
enum DeskAuditAction {
  CREATED
  EDITED
  READ
  PINNED
  UNPINNED
  ARCHIVED
  UNARCHIVED
  DELETED
  CONVERTED_TO_TASK
  CONVERTED_TO_REMINDER
  PRIORITY_CHANGED
  POSTPONED
  COMPLETED
  REOPENED
  REPLIED
}

model DeskAuditLog {
  id         String          @id @default(cuid())
  entityType String
  entityId   String
  userId     String
  user       User            @relation("DeskAuditUser", fields: [userId], references: [id])
  action     DeskAuditAction
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  name                  String
  password              String
  role                  Role
  viewPreferences       String[]        @default(["KANBAN", "TABLA"])
  theme                 ThemePreference @default(LIGHT)
  lastLoginAt           DateTime?
  badges                String[]        @default([])
  dataConsentAccepted   Boolean         @default(false)
  dataConsentAcceptedAt DateTime?
  // Ajuste puntual del Administrador: si está definida, los KPIs mensuales/semanales
  // de este usuario se calculan desde esta fecha en vez del inicio real del período.
  kpiStartDate          DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  assignedTasks               Task[]                @relation("AssignedTasks")
  createdTasks                Task[]                @relation("CreatedTasks")
  comments                    Comment[]
  activities                  TaskActivity[]
  notifications               Notification[]
  reports                     MonthlyReport[]       @relation("GeneratedReports")
  knowledgeDocs               KnowledgeDocument[]
  announcements               Announcement[]        @relation("AnnouncementAuthor")
  hostedMeetings              Meeting[]             @relation("HostedMeetings")
  meetingInvites              MeetingInvitee[]      @relation("MeetingInvitations")
  closedMonths                MonthClosure[]        @relation("MonthClosures")
  proposedIdeas               ImprovementIdea[]     @relation("IdeaAuthor")
  ideaStatusChanges           IdeaStatusHistory[]   @relation("IdeaStatusChanger")
  ideaVotes                   IdeaVote[]
  taskCommentViews            TaskCommentView[]
  systemConfigChanges         SystemConfigHistory[] @relation("SystemConfigUpdatedBy")
  dataSubjectRequests         DataSubjectRequest[]  @relation("DataSubjectRequestUser")
  dataSubjectRequestsResolved DataSubjectRequest[]  @relation("DataSubjectRequestResolver")
  dataPurgesExecuted          DataPurgeLog[]        @relation("DataPurgeExecutor")
  activityComments            ActivityComment[]
  activityAuditLogs           ActivityAuditLog[]    @relation("ActivityAuditAdmin")
  leaveRecords                LeaveRecord[]         @relation("LeaveRecordUser")
  leaveRecordsCreated         LeaveRecord[]         @relation("LeaveRecordCreator")
  specialStatuses             SpecialStatus[]       @relation("SpecialStatusUser")
  specialStatusesCreated      SpecialStatus[]       @relation("SpecialStatusCreator")
  analyticsAuditLogs          AnalyticsAuditLog[]   @relation("AnalyticsAuditUser")
  targetTimeValidations       Task[]                @relation("TargetTimeValidator")
  targetTimeAuditLogs         TargetTimeAuditLog[]  @relation("TargetTimeAuditUser")
  endDateApprovals            Task[]                @relation("EndDateApprover")
  endDateAuditLogs            EndDateAuditLog[]     @relation("EndDateAuditUser")

  responsibleProjects      Project[]            @relation("ProjectResponsible")
  createdProjects          Project[]            @relation("ProjectCreatedBy")
  projectParticipations    ProjectParticipant[] @relation("ProjectParticipantUser")
  projectParticipantsAdded ProjectParticipant[] @relation("ProjectParticipantAddedBy")
  responsiblePhases        ProjectPhase[]       @relation("ProjectPhaseResponsible")
  projectActivities        ProjectActivity[]    @relation("ProjectActivityAuthor")
  projectComments          ProjectComment[]     @relation("ProjectCommentAuthor")
  projectDocumentsUploaded ProjectDocument[]    @relation("ProjectDocumentUploadedBy")
  projectHistoryActions    ProjectHistory[]     @relation("ProjectHistoryActor")

  recoveryItemsDeleted  RecoveryItem[]     @relation("RecoveryDeletedBy")
  recoveryItemsRestored RecoveryItem[]     @relation("RecoveryRestoredBy")
  recoveryItemsPurged   RecoveryItem[]     @relation("RecoveryPurgedBy")
  recoveryAuditLogs     RecoveryAuditLog[] @relation("RecoveryAuditUser")

  sentDeskNotes     DeskNote[] @relation("DeskNoteSender")
  receivedDeskNotes DeskNote[] @relation("DeskNoteRecipient")
  deskNoteReplies   DeskNoteReply[]    @relation("DeskNoteReplyAuthor")
  personalReminders PersonalReminder[] @relation("PersonalReminderUser")
  deskAuditLogs     DeskAuditLog[]     @relation("DeskAuditUser")

  executiveReportsGenerated ExecutiveReportSnapshot[] @relation("ExecutiveReportsGenerated")
  executiveReportAudits     ExecutiveReportAuditLog[] @relation("ExecutiveReportAuditUser")
}

model ActivityReason {
  id            String    @id @default(cuid())
  key           String    @unique
  label         String
  description   String?
  isActive      Boolean   @default(true)
  // Archivado: se retira del listado principal de gestión sin borrarse
  // físicamente — el histórico de TaskActivity sigue resolviendo su label
  // original. Distinto de isActive (que solo controla si es seleccionable
  // para actividades nuevas); archivar fuerza isActive=false también.
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  assignedRoles String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  year      Int
  createdAt DateTime @default(now())

  @@index([year])
}

model LeaveRecord {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("LeaveRecordUser", fields: [userId], references: [id], onDelete: Cascade)
  type            LeaveType
  date            DateTime
  isFullDay       Boolean
  durationMinutes Int?
  observation     String?
  createdBy       String
  creator         User      @relation("LeaveRecordCreator", fields: [createdBy], references: [id])
  createdAt       DateTime  @default(now())

  @@index([userId, date])
}

// Estado especial de personal (maternidad/lactancia) — mientras esté vigente para un
// día, la base/límites de KPI de ese usuario ese día son los configurados aquí (no
// las horas efectivas/límites configurados globalmente). Configurable por registro
// (no fijo) desde 2026-07-18 — ver src/lib/specialStatus.ts.
model SpecialStatus {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation("SpecialStatusUser", fields: [userId], references: [id], onDelete: Cascade)
  type          SpecialStatusType
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean           @default(true)
  // Base de horas diarias — usada para las horas objetivo/base (agregación
  // semanal/mensual y denominador del %), separada del límite Moderado/Óptimo.
  dailyHours    Float             @default(6)
  limitLow      Float             @default(5)
  // Límite Moderado/Óptimo — el umbral real de clasificación del semáforo,
  // independiente de dailyHours (por defecto son iguales, pero no tienen que serlo).
  limitBase     Float             @default(6)
  limitHigh     Float             @default(7)
  limitOverload Float             @default(8)
  createdBy     String
  creator       User              @relation("SpecialStatusCreator", fields: [createdBy], references: [id])
  createdAt     DateTime          @default(now())

  @@index([userId, startDate])
}

model DataSubjectRequest {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation("DataSubjectRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  type        DataRequestType
  description String?
  status      DataRequestStatus @default(PENDIENTE)
  resolvedBy  String?
  resolver    User?             @relation("DataSubjectRequestResolver", fields: [resolvedBy], references: [id])
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@index([status, createdAt])
}

model LoginAttempt {
  id            String    @id @default(cuid())
  ip            String    @unique
  attempts      Int       @default(0)
  blockedUntil  DateTime?
  lastAttemptAt DateTime
  createdAt     DateTime  @default(now())
}

model DataPurgeLog {
  id             String   @id @default(cuid())
  executedBy     String
  executor       User     @relation("DataPurgeExecutor", fields: [executedBy], references: [id])
  reportsDeleted Int
  tasksDeleted   Int
  docsDeleted    Int
  createdAt      DateTime @default(now())
}

model SystemConfigHistory {
  id         String    @id @default(cuid())
  key        String
  value      String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  updatedBy  String
  updater    User      @relation("SystemConfigUpdatedBy", fields: [updatedBy], references: [id])
  createdAt  DateTime  @default(now())

  @@index([key, validFrom])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  expiresAt DateTime
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Task {
  id                      String             @id @default(cuid())
  title                   String
  description             String?
  status                  TaskStatus         @default(PENDIENTE)
  priority                TaskPriority
  frequency               TaskFrequency
  startDate               DateTime
  endDate                 DateTime
  // Tiempo objetivo inicial (§Sprint 6 S6-B) — definido al crear la tarea. El
  // nombre de columna se mantiene por compatibilidad con datos existentes;
  // en la interfaz se presenta como "Tiempo objetivo". NUNCA se sobrescribe
  // automáticamente con horas reales (§S6-E) — solo la validación humana
  // (targetTimeValidated) puede reemplazarlo como referencia oficial.
  estimatedHours          Float
  realHours               Float              @default(0)
  // Tiempo objetivo validado (§Sprint 6 S6-B/S6-C) — null hasta que un líder
  // autorizado (Administrador/Jefe Nacional/Coordinador Nacional, nunca el
  // responsable de la tarea) lo valide explícitamente. Mientras sea null, la
  // referencia oficial sigue siendo estimatedHours (§S6-H). Cada cambio queda
  // en TargetTimeAuditLog.
  targetTimeValidated     Float?
  targetTimeValidatedAt   DateTime?
  targetTimeValidatedById String?
  targetTimeValidator     User?              @relation("TargetTimeValidator", fields: [targetTimeValidatedById], references: [id])
  // Validación de Fecha Fin por líderes (mejora — ver docs/AUDIT_LOG.md).
  // Mismo espíritu que targetTimeValidated: gobierno/trazabilidad sobre un
  // campo que la tarea ya tenía (endDate), nunca la bloquea — una tarea
  // PENDIENTE sigue funcionando exactamente igual que hoy en el resto de la
  // app (KPIs, overdue, cierre de mes, etc., todos siguen leyendo endDate
  // directamente). endDate solo cambia de valor si el líder elige MODIFICAR.
  endDateApprovalStatus   EndDateApprovalStatus @default(PENDIENTE)
  endDateApprovedAt       DateTime?
  endDateApprovedById     String?
  endDateApprover         User?              @relation("EndDateApprover", fields: [endDateApprovedById], references: [id])
  progress                Int                @default(0)
  completedAt             DateTime?
  type                    TaskType           @default(FIJA)
  assignedToId            String
  assignedTo              User               @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdById             String
  createdBy               User               @relation("CreatedTasks", fields: [createdById], references: [id])
  comments                Comment[]
  activities              TaskActivity[]
  commentViews            TaskCommentView[]
  convertedFromReminders  PersonalReminder[] @relation("ReminderConvertedTask")
  color                   String?
  archivedMonth           String?
  archivedAt              DateTime?
  corrected               Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TaskCommentView {
  id       String   @id @default(cuid())
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  viewedAt DateTime @default(now())

  @@unique([taskId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  taskId    String?
  taskTitle String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TaskActivity {
  id              String            @id @default(cuid())
  taskId          String
  task            Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId        String
  author          User              @relation(fields: [authorId], references: [id])
  reason          String
  startTime       String?
  endTime         String?
  duration        Int
  description     String?
  // Registro retroactivo (horas de días laborables anteriores).
  isRetroactive   Boolean           @default(false)
  activityDate    DateTime?
  // Edición de horas por un Administrador (ver ActivityAuditLog para el historial completo).
  adminComment    String?
  modifiedByAdmin Boolean           @default(false)
  modifiedAt      DateTime?
  createdAt       DateTime          @default(now())
  comments        ActivityComment[]
}

model ActivityComment {
  id         String       @id @default(cuid())
  activityId String
  activity   TaskActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation(fields: [authorId], references: [id])
  text       String
  createdAt  DateTime     @default(now())

  @@index([activityId, createdAt])
}

// Historial de auditoría de ediciones de horas por un Administrador. activityId es
// intencionalmente una referencia suelta (sin FK) para que el registro de auditoría
// sobreviva aunque la actividad o la tarea que la contiene se elimine más adelante.
model ActivityAuditLog {
  id          String   @id @default(cuid())
  activityId  String
  adminId     String
  admin       User     @relation("ActivityAuditAdmin", fields: [adminId], references: [id])
  oldDuration Int
  newDuration Int
  comment     String
  modifiedAt  DateTime @default(now())

  @@index([activityId])
}

enum ReportScope {
  JEFE
  COORDINADOR
}

model MonthlyReport {
  id          String      @id @default(cuid())
  month       Int
  year        Int
  generatedBy String
  generator   User        @relation("GeneratedReports", fields: [generatedBy], references: [id])
  scope       ReportScope
  data        Json
  aiAnalysis  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([month, year, scope])
}

enum MonthClosureType {
  NORMAL
  EARLY
  MANUAL
}

// Motor de Cierre Inteligente con Fecha de Corte — `cutoffDate` es el límite
// real hasta el cual se consideró información al cerrar (puede ser anterior
// al último día calendario del mes); `closedAt` (ya existente) sigue siendo
// el instante en que se EJECUTÓ el cierre — ambas fechas se conservan porque
// responden preguntas distintas ("hasta cuándo cuenta la data" vs "cuándo se
// generó el cierre") y el Executive Reporting necesita mostrar las dos para
// trazabilidad completa. `workingDaysConsidered`/`workingHoursConsidered`/
// `calendarDaysConsidered`/`calendarDaysTotal` quedan congelados aquí en el
// momento del cierre y nunca se recalculan — son la fuente de verdad
// inmutable que consume Analytics/KPIs/Executive Reporting para ese mes.
model MonthClosure {
  id                     String           @id @default(cuid())
  month                  Int
  year                   Int
  closedBy               String
  closer                 User             @relation("MonthClosures", fields: [closedBy], references: [id])
  closedAt               DateTime         @default(now())
  cutoffDate             DateTime
  closureType            MonthClosureType @default(NORMAL)
  calendarDaysTotal      Int
  calendarDaysConsidered Int
  workingDaysConsidered  Int
  workingHoursConsidered Float
  totalTasks             Int
  completedTasks         Int
  summary                Json
  corrections            Json?

  @@unique([month, year])
}

enum IdeaImpact {
  ALTO
  MEDIO
  BAJO
}

enum IdeaStatus {
  PROPUESTA
  EN_REVISION
  APROBADA
  EN_DESARROLLO
  EN_PRUEBAS
  IMPLEMENTADA
  RECHAZADA
}

model ImprovementIdea {
  id             String              @id @default(cuid())
  title          String
  description    String
  impact         IdeaImpact
  status         IdeaStatus          @default(PROPUESTA)
  progress       Int                 @default(0)
  authorId       String
  author         User                @relation("IdeaAuthor", fields: [authorId], references: [id])
  attachmentUrl  String?
  attachmentData String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  history        IdeaStatusHistory[]
  votes          IdeaVote[]
}

model IdeaVote {
  id        String          @id @default(cuid())
  ideaId    String
  idea      ImprovementIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([ideaId, userId])
}

model IdeaStatusHistory {
  id         String          @id @default(cuid())
  ideaId     String
  idea       ImprovementIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  fromStatus IdeaStatus
  toStatus   IdeaStatus
  changedBy  String
  changer    User            @relation("IdeaStatusChanger", fields: [changedBy], references: [id])
  comment    String?
  createdAt  DateTime        @default(now())
}

enum KnowledgeDocumentStatus {
  PROCESANDO
  LISTO
  ERROR
}

model KnowledgeDocument {
  id              String                  @id @default(cuid())
  title           String
  fileName        String
  content         String?
  githubPath      String?
  githubSha       String?
  status          KnowledgeDocumentStatus @default(LISTO)
  processingError String?
  uploadedById    String
  uploadedBy      User                    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt       DateTime                @default(now())
  chunks          DocumentChunk[]
}

model DocumentChunk {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Json
  pageNumber Int
  chunkIndex Int
}

enum MeetingStatus {
  PROGRAMADA
  EN_CURSO
  FINALIZADA
}

model Meeting {
  id                 String           @id @default(cuid())
  title              String
  description        String?
  hostId             String
  host               User             @relation("HostedMeetings", fields: [hostId], references: [id])
  meetingDate        DateTime
  duration           Int
  zoomMeetingId      String?
  zoomJoinUrl        String?
  zoomPassword       String?
  status             MeetingStatus    @default(PROGRAMADA)
  otterInvited       Boolean          @default(false)
  otterSummary       String?
  otterTranscriptUrl String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  invitees           MeetingInvitee[]
}

// Auditoría del motor de Analytics (src/lib/analytics.ts) — un registro por
// cálculo de un indicador versionado (Score de Salud, Índice de Riesgo
// Operativo) para poder explicar por qué un informe antiguo mostraba un
// valor distinto al de hoy (cambios de fórmula entre versiones del motor, o
// de configuración/datos de entrada). `kind` identifica el indicador
// ("health_score" | "operational_risk"); `period` es el mes evaluado
// ("2026-07"). No se audita cada lectura cacheada, solo cada cálculo real.
model AnalyticsAuditLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("AnalyticsAuditUser", fields: [userId], references: [id], onDelete: Cascade)
  kind          String
  period        String
  inputs        Json
  result        Json
  engineVersion String
  createdAt     DateTime @default(now())

  @@index([userId, kind, period])
}

// Auditoría de validaciones del Tiempo Objetivo (§Sprint 6 S6-C/S6-G). taskId es
// intencionalmente una referencia suelta (sin FK), igual que ActivityAuditLog,
// para que el registro sobreviva aunque la tarea se elimine más adelante.
// Nunca se elimina ni se sobrescribe un registro — cada validación agrega uno nuevo.
model TargetTimeAuditLog {
  id            String                 @id @default(cuid())
  taskId        String
  userId        String
  user          User                   @relation("TargetTimeAuditUser", fields: [userId], references: [id])
  userRole      Role
  previousValue Float?
  newValue      Float
  reason        TargetTimeAdjustReason
  reasonDetail  String?
  ipAddress     String?
  createdAt     DateTime               @default(now())

  @@index([taskId])
}

// Auditoría de validaciones de Fecha Fin — mismo patrón que
// TargetTimeAuditLog (taskId sin FK para sobrevivir al borrado de la tarea;
// userId sí con FK). `action` distingue PROPUESTA (el colaborador
// propuso/re-propuso un valor) de las 3 decisiones del líder.
model EndDateAuditLog {
  id            String              @id @default(cuid())
  taskId        String
  userId        String
  user          User                @relation("EndDateAuditUser", fields: [userId], references: [id])
  userRole      Role
  action        EndDateAuditAction
  previousValue DateTime?
  newValue      DateTime?
  observaciones String?
  ipAddress     String?
  createdAt     DateTime            @default(now())

  @@index([taskId])
}

enum ExecutiveReportType {
  MENSUAL
  RANGO_MESES
  RANGO_PERSONALIZADO
}

enum ExecutiveReportPeriodStatus {
  EN_CURSO
  CERRADO
  HISTORICO
}

enum ExecutiveReportOrigin {
  GENERATED
  LEGACY_MIGRATION
}

enum ExecutiveReportIntegrity {
  FULL
  PARTIAL
}

// Executive Reporting Engine 2.0 — snapshot inmutable de un informe ejecutivo
// generado. A diferencia de MonthlyReport (que se sobrescribe por
// (month,year,scope) vía upsert), cada generación crea una fila nueva que
// nunca se modifica ni se recalcula: `data`/`nova`/`dataQuality` son la
// fotografía exacta del estado en `generatedAt`/`fechaCorte`. `collaboratorIds`
// es el roster congelado — fuente de verdad del alcance, no `scope` (que
// queda solo como etiqueta de visualización derivada del rol del generador).
// Filas con `origin = LEGACY_MIGRATION` provienen del backfill de una sola
// corrida desde MonthlyReport (ver scripts/backfill-executive-report-snapshots.ts);
// MonthlyReport permanece intacta como tabla legacy, nunca se borra ni se
// le vuelve a escribir.
model ExecutiveReportSnapshot {
  id                     String                       @id @default(cuid())
  reportId               String                       @unique
  type                   ExecutiveReportType
  scope                  ReportScope
  origin                 ExecutiveReportOrigin         @default(GENERATED)
  integrityFlag          ExecutiveReportIntegrity      @default(FULL)
  legacyMonthlyReportId  String?
  migratedAt             DateTime?
  generatedBy            String
  generator              User                          @relation("ExecutiveReportsGenerated", fields: [generatedBy], references: [id])
  generatedAt            DateTime                      @default(now())
  periodLabel            String
  periodStart            DateTime
  periodEnd              DateTime
  fechaCorte             DateTime
  periodStatus           ExecutiveReportPeriodStatus
  filters                Json
  collaboratorIds        String[]
  collaboratorCount      Int
  analyticsEngineVersion String
  formulaSetVersion      String
  reportingEngineVersion String
  nexoVersion            String
  data                   Json
  nova                   Json?
  novaDegraded           Boolean                       @default(false)
  dataQuality            Json
  generationMs           Int
  createdAt              DateTime                      @default(now())

  @@index([generatedBy, createdAt])
  @@index([type, periodStart, periodEnd])
  @@index([origin])
}

// Auditoría del Executive Reporting Engine — referencia suelta (reportId como
// String plano, sin FK), mismo patrón que ActivityAuditLog/TargetTimeAuditLog:
// sobrevive aunque el snapshot referenciado se purgue en el futuro. Append-only,
// nunca se sobrescribe — un registro por evento (generated/generation_failed/
// nova_degraded/viewed/exported_pdf/exported_excel/legacy_migrated).
model ExecutiveReportAuditLog {
  id                     String    @id @default(cuid())
  reportId               String
  action                 String
  userId                 String
  user                   User      @relation("ExecutiveReportAuditUser", fields: [userId], references: [id], onDelete: Cascade)
  step                   String?
  message                String?
  period                 String?
  fechaCorte             DateTime?
  filtersApplied         Json?
  collaboratorCount      Int?
  generationMs           Int?
  analyticsEngineVersion String?
  formulaSetVersion      String?
  nexoVersion            String?
  createdAt              DateTime  @default(now())

  @@index([reportId])
  @@index([userId, createdAt])
}

model MeetingInvitee {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("MeetingInvitations", fields: [userId], references: [id])
  attended  Boolean @default(false)

  @@unique([meetingId, userId])
}

// Estado de una entidad soft-eliminada, de cualquier módulo registrado en
// src/lib/recoveryCenter.ts. `entityId` es una referencia suelta (sin FK) —
// vive en la tabla propia de cada módulo (Project, y en el futuro Task,
// KnowledgeDocument, etc.), no hay una tabla única de "entidades" para
// apuntar con una FK real. Un mismo (entityType, entityId) puede tener
// varias filas a lo largo del tiempo (papelera -> restaurado -> papelera de
// nuevo) — el registro ACTIVE vigente es el más reciente con ese status.
model RecoveryItem {
  id             String          @id @default(cuid())
  entityType     String
  entityId       String
  // Snapshot legible al momento de eliminar (ej. nombre del proyecto) — permite
  // listar la papelera sin depender de que la fila original siga resolviéndose.
  entityLabel    String?
  moduleLabel    String
  status         RecoveryStatus  @default(ACTIVE)
  deletedById    String
  deletedBy      User            @relation("RecoveryDeletedBy", fields: [deletedById], references: [id])
  deletedAt      DateTime        @default(now())
  retentionHours Int
  expiresAt      DateTime
  restoredById   String?
  restoredBy     User?           @relation("RecoveryRestoredBy", fields: [restoredById], references: [id])
  restoredAt     DateTime?
  purgedById     String?
  purgedBy       User?           @relation("RecoveryPurgedBy", fields: [purgedById], references: [id])
  purgedAt       DateTime?
  purgeOrigin    RecoveryOrigin?
  createdAt      DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([status, expiresAt])
}

// Auditoría CENTRAL de toda operación del Centro de Recuperación, para
// cualquier módulo — nunca una tabla de auditoría por módulo. `entityId` es
// intencionalmente una referencia suelta (sin FK), igual criterio que
// ActivityAuditLog/TargetTimeAuditLog, para que el registro sobreviva a la
// purga definitiva de la entidad original. `userId` es nulo cuando el origen
// es AUTOMATIC (purga por expiración, sin actor humano).
model RecoveryAuditLog {
  id          String            @id @default(cuid())
  entityType  String
  entityId    String
  moduleLabel String
  userId      String?
  user        User?             @relation("RecoveryAuditUser", fields: [userId], references: [id])
  operation   RecoveryOperation
  origin      RecoveryOrigin
  createdAt   DateTime          @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Iniciativa transversal con fases y participantes propios. Independiente de
// Task: no aparece en /tasks, no cuenta para carga laboral/Analytics todavía
// (§13 — el modelo solo se deja preparado, `realHours`/`targetTimeHours` usan
// la misma convención de Task para que una futura integración sea directa).
// No se cierra por cambio de mes (§10): solo status COMPLETADO/CANCELADO
// detiene la acumulación, y ni así se borra información.
model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  status          ProjectStatus @default(PENDIENTE)
  priority        TaskPriority
  area            String?
  tags            String[]      @default([])
  observations    String?
  startDate       DateTime
  targetDate      DateTime
  // Tiempo objetivo global, en horas — nunca "horas estimadas" (§12).
  targetTimeHours Float
  // Recalculado desde ProjectActivity.duration en cada alta/edición.
  realHours       Float         @default(0)
  completedAt     DateTime?
  responsibleId   String
  responsible     User          @relation("ProjectResponsible", fields: [responsibleId], references: [id])
  createdById     String
  createdBy       User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  // Bandera local de conveniencia mantenida por el Centro de Recuperación
  // (src/lib/recoveryCenter.ts, adaptador PROJECT) — permite filtrar
  // proyectos en la papelera con un WHERE simple en vez de un join contra
  // RecoveryItem en cada consulta. RecoveryItem sigue siendo la fuente de
  // verdad de retención/auditoría; esto es solo un espejo de su estado.
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  participants ProjectParticipant[]
  phases       ProjectPhase[]
  activities   ProjectActivity[]
  comments     ProjectComment[]
  documents    ProjectDocument[]
  history      ProjectHistory[]

  @@index([status])
  @@index([deletedAt])
}

model ProjectParticipant {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ProjectParticipantUser", fields: [userId], references: [id])
  addedById String
  addedBy   User     @relation("ProjectParticipantAddedBy", fields: [addedById], references: [id])
  addedAt   DateTime @default(now())

  @@unique([projectId, userId])
}

// Cada fase tiene su propio responsable/progreso/tiempo objetivo — no hereda
// el registro de actividades de Task (ver ProjectActivity.phaseId, opcional).
model ProjectPhase {
  id              String     @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  status          TaskStatus @default(PENDIENTE)
  responsibleId   String?
  responsible     User?      @relation("ProjectPhaseResponsible", fields: [responsibleId], references: [id])
  startDate       DateTime?
  targetDate      DateTime?
  progress        Int        @default(0)
  notes           String?
  targetTimeHours Float?
  order           Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  activities ProjectActivity[]

  @@index([projectId, order])
}

// Registro de actividades de un participante — mismo principio de
// "cada usuario registra únicamente su trabajo" (§5) que TaskActivity, con
// ventana de registro retroactivo de 2 días hábiles reutilizando
// src/lib/businessTime.ts sin modificarlo (§6, §Restricciones).
// Sprint 2.1 §6: se reemplazó el campo suelto `time` (hora del día) por
// `startTime`/`endTime` — la duración ya no se ingresa a mano, se calcula
// siempre desde el rango horario (ver src/app/api/projects/[id]/activities/route.ts).
model ProjectActivity {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId       String?
  phase         ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  authorId      String
  author        User          @relation("ProjectActivityAuthor", fields: [authorId], references: [id])
  description   String
  comments      String?
  startTime     String?
  endTime       String?
  duration      Int
  isRetroactive Boolean       @default(false)
  activityDate  DateTime?
  createdAt     DateTime      @default(now())

  documents ProjectDocument[]

  @@index([projectId, createdAt])
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ProjectCommentAuthor", fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

// Repositorio propio del proyecto. `fileData` guarda el archivo en base64
// (mismo patrón que ImprovementIdea.attachmentData/KnowledgeDocument.content)
// — sin integración a almacenamiento externo todavía. `previousVersionId` es
// una referencia suelta (no FK) para permitir historial de versiones sin
// encadenar borrados.
model ProjectDocument {
  id                String                  @id @default(cuid())
  projectId         String
  project           Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityId        String?
  activity          ProjectActivity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  category          ProjectDocumentCategory @default(OTRO)
  fileName          String
  mimeType          String?
  fileData          String?                 @db.Text
  version           Int                     @default(1)
  previousVersionId String?
  uploadedById      String
  uploadedBy        User                    @relation("ProjectDocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt         DateTime                @default(now())

  @@index([projectId])
}

// Bitácora de auditoría del módulo (§9/§14) — todo evento relevante queda
// registrado con actor, fecha y valor anterior/nuevo. Nunca se elimina ni se
// sobrescribe (mismo criterio que TargetTimeAuditLog).
model ProjectHistory {
  id            String              @id @default(cuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId       String
  actor         User                @relation("ProjectHistoryActor", fields: [actorId], references: [id])
  event         ProjectHistoryEvent
  description   String
  previousValue Json?
  newValue      Json?
  createdAt     DateTime            @default(now())

  @@index([projectId, createdAt])
}
