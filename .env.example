SESSION_SECRET="genera-un-secreto-de-al-menos-32-caracteres-aqui"

# --- Puente hacia el backend Django (Fase 2 de la migracion de stack) ---
# URL base de la API de backend/ (ver backend/.env). Usado por
# src/lib/djangoSession.ts para establecer una sesion Django en paralelo al
# login real y para las rutas /api/users/* ya cortadas a Django.
DJANGO_API_URL=http://localhost:8000/api/v1
GEMINI_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GITHUB_TOKEN=
GITHUB_DOCS_REPO=owner/nexo-documentos

# --- Migracion de stack (Fase 1: nucleo de seguridad, ver docs/plan) ---
# Solo necesarias si se usa ./docker-compose.yml (servicio mssql) en vez de
# una instancia de SQL Server ya existente. En la maquina de desarrollo del
# usuario, backend/.env apunta directo a una instancia compartida en
# localhost:1433 (base propia "gestion_tareas") y estas variables no se
# usan.
DB_NAME=nexo_security_dev
DB_PASSWORD=change-me
DB_PORT=1433
