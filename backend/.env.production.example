# Plantilla de variables de entorno de PRODUCCIÓN para el backend Django
# — ver docs/DEPLOYMENT_IIS.md. Copiá este archivo a "backend/.env" en el
# servidor y completá los valores reales. Nunca commitees el ".env" real.
# `config/settings/base.py::_fail_fast_on_missing_env` no deja arrancar la
# app si falta SECRET_KEY/JWT_SECRET_KEY/DB_NAME/DB_USER/DB_PASSWORD.

DJANGO_SETTINGS_MODULE=config.settings.production

# --- Django ---
# Generar cada clave por separado con:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=false
# Dominio(s) público(s) reales por los que se accede al sitio — sin esto
# Django devuelve 400 Bad Request a cualquier request. Ejemplo:
# ALLOWED_HOSTS=nexo.miempresa.com
# Sin dominio, va la IP del servidor de aplicaciones (10.0.2.33, la del
# sitio de IIS), mas los locales que usan los health checks del propio
# servidor. Si Django recibe una peticion con un Host que no este en esta
# lista, responde 400 a todo, sin mas explicacion.
ALLOWED_HOSTS=10.0.2.33,127.0.0.1,localhost
SYSTEM_NAME=Nexo
# URL pública real del FRONTEND (Next.js, detrás del mismo IIS) — la usa
# CORS_ALLOWED_ORIGINS por defecto si no lo pisás abajo.
#
# TIENE QUE INCLUIR EL PUERTO. El sitio de Nexo en IIS está publicado en el
# 4080 (el 80 lo ocupa el Default Web Site del servidor compartido), y de
# esta variable sale el enlace del correo de recuperación de contraseña
# (apps.authentication.emails.build_password_reset_url). Sin el puerto, el
# correo se envía igual y el enlace lleva al sitio equivocado.
FRONTEND_URL=http://10.0.2.33:4080
BACKEND_PORT=8000
# URL pública por la que se documenta la API en drf-spectacular — no
# necesita ser accesible externamente si Django solo corre en localhost
# (ver docs/DEPLOYMENT_IIS.md, "Django no se expone vía IIS").
PUBLIC_API_URL=http://127.0.0.1:8000

# --- SQL Server de PRODUCCIÓN ---
# El esquema se construye con `migrate` + `seed_superadmin`, o de una sola
# vez con el script de `backend/scripts/sql/` (ver su README.md), que crea
# esta misma base con este nombre.
DB_NAME=ia_gestion_tareas
DB_USER=ia_gestion_tareas
# La contrasena real va aca, en el .env del servidor (nunca en esta plantilla)
DB_PASSWORD=
DB_HOST=10.0.2.51
DB_PORT=1433
# Verificar con `Get-OdbcDriver` en PowerShell en el servidor real —
# puede diferir del driver de la máquina de desarrollo. En SER-WEBAI
# (10.0.2.33) el único driver moderno instalado es el 18: con el 17 el
# backend no conecta (ver docs/AUDIT_LOG.md § 2026-09-08).
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# --- HTTPS ---
# Seguro por defecto: si no declaras nada, Django exige https (redirige a
# https y emite las cookies con `secure`). El despliegue interno de este
# sistema es por IP y sin TLS, asi que aca va en "false" — ver
# config/settings/production.py para el detalle y el costo de seguridad.
#
# Tiene que valer LO MISMO que el REQUIRE_HTTPS del .env de la raiz
# (Next.js): si uno exige https y el otro no, el login falla sin un error
# que lo explique.
#
# El dia que el sitio tenga certificado TLS, borrar esta linea (o ponerla en
# "true") y reiniciar los dos servicios.
REQUIRE_HTTPS=false

# --- JWT ---
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS / CSRF ---
# El navegador nunca llama a Django directo (ver
# .claude/rules/architecture.md) — estos valores importan sobre todo si
# se decide exponer /admin/ o la documentación de la API externamente.
# Un "origin" incluye el puerto: http://10.0.2.33 y http://10.0.2.33:4080
# son dos orígenes distintos para el navegador.
CORS_ALLOWED_ORIGINS=http://10.0.2.33:4080
CSRF_TRUSTED_ORIGINS=http://10.0.2.33:4080

# --- Correo (recuperación de contraseña) ---
# Sin esto, "¿Olvidaste tu contraseña?" no envía nada: el sistema crea el
# token, responde que envió el correo, y nadie lo recibe. El error no se
# propaga a propósito (la respuesta debe ser idéntica exista o no la
# cuenta), así que la verificación no es opcional:
#
#   manage.py check                                  <- errores de configuración
#   manage.py diagnose_email tu-cuenta@grupolaar.com <- envío real de prueba
#
# El servidor de correo de la empresa es Zimbra (Postfix), en
# mail.grupolaar.com / 10.0.2.53 — verificado el 2026-09-09: el puerto 25
# está cerrado, así que NO hay relay sin autenticar; hay que usar el 587
# con STARTTLS (o el 465 con EMAIL_USE_SSL=true) y una cuenta real. Su
# certificado es válido y público, y cubre el nombre mail.grupolaar.com —
# usá el nombre y no la IP, porque Django valida el certificado.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.grupolaar.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Buzón de Zimbra desde el que Nexo envía. Va la dirección completa como
# usuario, y la contraseña real solo en el .env del servidor.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Tiene que ser una dirección que el servidor acepte como remitente —
# normalmente la misma de EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=
# Segundos de espera. Es una ruta pública sin autenticar: sin timeout, un
# servidor que no responde deja el request colgado sin límite.
EMAIL_TIMEOUT=10

# --- Zoom (opcional — sin esto, creación de reuniones cae al fallback simulado) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Bootstrap del primer usuario (solo lectura de
# scripts/seed_superadmin_bootstrap.ps1 — no la usa Django directamente
# en cada arranque). Podés omitirla y que el script te la pida
# interactivamente en su lugar. ---
# SUPERADMIN_PASSWORD=
