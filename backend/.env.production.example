# Plantilla de variables de entorno de PRODUCCIÓN para el backend Django
# — ver docs/DEPLOYMENT_IIS.md. Copiá este archivo a "backend/.env" en el
# servidor y completá los valores reales. Nunca commitees el ".env" real.
# `config/settings/base.py::_fail_fast_on_missing_env` no deja arrancar la
# app si falta SECRET_KEY/JWT_SECRET_KEY/DB_NAME/DB_USER/DB_PASSWORD.

DJANGO_SETTINGS_MODULE=config.settings.production

# --- Django ---
# Generar cada clave por separado con:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=false
# Dominio(s) público(s) reales por los que se accede al sitio — sin esto
# Django devuelve 400 Bad Request a cualquier request. Ejemplo:
# ALLOWED_HOSTS=nexo.miempresa.com
ALLOWED_HOSTS=
SYSTEM_NAME=Nexo
# URL pública real del FRONTEND (Next.js, detrás del mismo IIS) — la usa
# CORS_ALLOWED_ORIGINS por defecto si no lo pisás abajo.
FRONTEND_URL=https://nexo.miempresa.com
BACKEND_PORT=8000
# URL pública por la que se documenta la API en drf-spectacular — no
# necesita ser accesible externamente si Django solo corre en localhost
# (ver docs/DEPLOYMENT_IIS.md, "Django no se expone vía IIS").
PUBLIC_API_URL=http://127.0.0.1:8000

# --- SQL Server de PRODUCCIÓN (base vacía — `migrate` construye el
# esquema, `seed_superadmin` crea el primer usuario) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=1433
# Verificar con `Get-OdbcDriver` en PowerShell en el servidor real —
# puede diferir del driver de la máquina de desarrollo.
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# --- JWT ---
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS / CSRF ---
# El navegador nunca llama a Django directo (ver
# .claude/rules/architecture.md) — estos valores importan sobre todo si
# se decide exponer /admin/ o la documentación de la API externamente.
CORS_ALLOWED_ORIGINS=https://nexo.miempresa.com
CSRF_TRUSTED_ORIGINS=https://nexo.miempresa.com

# --- Correo (recuperación de contraseña real — reemplazar el backend de
# consola de desarrollo por un SMTP real) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@miempresa.com

# --- Zoom (opcional — sin esto, creación de reuniones cae al fallback simulado) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Bootstrap del primer usuario (solo lectura de
# scripts/seed_superadmin_bootstrap.ps1 — no la usa Django directamente
# en cada arranque). Podés omitirla y que el script te la pida
# interactivamente en su lugar. ---
# SUPERADMIN_PASSWORD=
