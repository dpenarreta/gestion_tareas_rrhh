# Copie este archivo a ".env" (dentro de backend/) y complete los valores.
# Nunca commitee ".env". Ver también el ".env.example" de la raíz del
# repositorio (variables usadas por docker-compose, no por Django
# directamente) y docs/database.md.

# --- Django ---
SECRET_KEY=<clave-segura-local>
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
SYSTEM_NAME=Nexo
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=8000

# --- SQL Server (nucleo de seguridad: usuarios/roles/permisos) ---
# Este proyecto usa una instancia de SQL Server COMPARTIDA en la maquina de
# desarrollo del usuario (localhost:1433, ya en uso por otros proyectos) en
# vez de un contenedor dedicado (docker-compose.yml queda solo como
# alternativa local si esa instancia compartida no esta disponible). La
# base de datos propia de este proyecto en esa instancia es "gestion_tareas"
# (creada una vez, vacia; `migrate` construye el esquema).
DB_NAME=gestion_tareas
DB_USER=sa
DB_PASSWORD=<password-de-la-instancia-compartida>
DB_HOST=localhost
DB_PORT=1433
# Ajustar al driver ODBC realmente instalado (verificar con
# `Get-OdbcDriver` en PowerShell); esta maquina de desarrollo solo tiene
# la version 17 instalada, no la 18 que trae skelleton_base por defecto.
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# --- JWT ---
JWT_SECRET_KEY=<clave-segura-local>
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Correo (por defecto, backend de consola: nada real se envía) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Zoom (OAuth Server-to-Server, apps.meetings) — opcionales: sin estos
# valores, la creación de reuniones cae al fallback de enlace simulado ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
