# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded attachments
/public/uploads

.vercel
.env*

# temp migration scripts (may reference env-provided DB creds, never commit)
/_migration_tmp

# backend (Django, Fase 1 de la migracion de stack)
backend/.venv
backend/__pycache__
backend/**/__pycache__
backend/**/migrations/__pycache__
backend/staticfiles
backend/db.sqlite3
backend/.pytest_cache

# frontend (Vite/React, Fase 1 de la migracion de stack)
frontend/node_modules
frontend/dist
