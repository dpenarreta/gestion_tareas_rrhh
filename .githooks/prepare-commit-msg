#!/bin/sh
# Agrega automáticamente una línea al Changelog de README.md con cada commit
# normal (no merge/squash/amend). La lógica real vive en update-changelog.js
# porque manipular el README de forma confiable en sh puro es frágil.
#
# Args que pasa git: $1 = archivo con el mensaje, $2 = origen (message|template|
# merge|squash|commit), $3 = SHA si es un --amend.

MSG_FILE="$1"
SOURCE="$2"
AMEND_SHA="$3"

case "$SOURCE" in
  merge|squash)
    exit 0
    ;;
esac

if [ -n "$AMEND_SHA" ]; then
  exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
node "$REPO_ROOT/.githooks/update-changelog.js" "$MSG_FILE" || true
